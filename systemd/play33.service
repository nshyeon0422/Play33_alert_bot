[Unit]
Description=Play33 reservation alert service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/play33_alert_bot
EnvironmentFile=/opt/play33_alert_bot/.env
ExecStart=/opt/play33_alert_bot/.venv/bin/python -m play33_alert_bot.main
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
